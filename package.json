{
  "name": "deepseek-harness-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Development and test orchestration for the DeepSeek Harness Connector. The published package is companion/; the Chrome Web Store package is extension/.",
  "license": "MIT",
  "author": "Corsen AI",
  "type": "module",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:page && npm run test:e2e",
    "test:unit": "node --test --experimental-strip-types \"companion/tests/*.test.ts\"",
    "test:page": "node --test --test-concurrency=1 --experimental-strip-types \"tests/page/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 --experimental-strip-types \"tests/e2e/*.test.ts\"",
    "typecheck": "npm run typecheck:companion && npm run typecheck:extension && npm run typecheck:tests",
    "typecheck:companion": "node companion/node_modules/typescript/bin/tsc -p companion/tsconfig.json --noEmit",
    "typecheck:extension": "node companion/node_modules/typescript/bin/tsc -p extension/tsconfig.json --noEmit",
    "typecheck:tests": "node companion/node_modules/typescript/bin/tsc -p tests/tsconfig.json --noEmit",
    "build": "node companion/node_modules/typescript/bin/tsc -p companion/tsconfig.build.json",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "ws": "^8.18.0"
  }
}
